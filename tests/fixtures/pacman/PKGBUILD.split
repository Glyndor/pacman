# A split package like Podman's, built by the real makepkg in the admission tests: two members of one base,
# the second depending on the first at the exact version, with the relations the products file allows.
pkgbase=podman
pkgname=(podman podman-docker)
pkgver=1.2.3
pkgrel=1
pkgdesc="A package built by a test"
arch=(x86_64)
url="https://glyndor.net"
license=(MIT)
options=(!strip !debug)

package_podman() {
	# The relations of the contract (v2.2): it replaces netavark and aardvark-dns, provides the network stack, and
	# depends on the containers-common of Arch, which it neither provides, conflicts with nor replaces.
	depends=(containers-common)
	provides=("netavark=2.1.0" "aardvark-dns=2.1.0" container-network-stack=2 podman-remote)
	conflicts=(netavark aardvark-dns)
	replaces=(netavark aardvark-dns)
	install -d "$pkgdir/usr/bin"
	printf '#!/bin/sh\necho podman\n' > "$pkgdir/usr/bin/podman"
	chmod 755 "$pkgdir/usr/bin/podman"
}

package_podman-docker() {
	arch=(any)
	depends=("podman=$pkgver-$pkgrel")
	provides=(docker)
	conflicts=(docker)
	install -d "$pkgdir/usr/bin"
	ln -s podman "$pkgdir/usr/bin/docker"
}
