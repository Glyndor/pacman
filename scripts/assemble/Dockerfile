# The Arch Linux image the database is built in, by digest. Nothing is built from this file: it is where the image is written
# so that Dependabot (docker ecosystem) reads it and proposes a newer digest of the same tag in a pull request, which runs the
# whole suite against it. Read by arch-image.sh, which prints the reference every script and test uses, and which refuses a
# file that has anything but this one line.
FROM docker.io/library/archlinux:latest@sha256:375a401bb3c6376b37f40b6dfa25067db37ec78d0b7af67ae6315f43a0184a9d
